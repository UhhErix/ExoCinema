<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ExoCinema.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- WinUI's WebView2 paints this brush where a transparent page should show what is behind it
                 (microsoft-ui-xaml: "DefaultBackgroundColor cannot be set to a transparent background"); behind it is
                 mpv's picture, so the brush is nothing. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="Transparent" />
                    <Color x:Key="SolidBackgroundFillColorBase">#00000000</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="Transparent" />
                    <Color x:Key="SolidBackgroundFillColorBase">#00000000</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
