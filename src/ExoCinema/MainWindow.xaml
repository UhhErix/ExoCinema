<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ExoCinema.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Exo Cinema">

    <!-- Transparent all the way down: mpv draws the picture into this window, and the page's WebView2 (a windowed one,
         MainWindow.xaml.cs › StartWebAsync) sits over it. -->
    <Grid x:Name="RootGrid" Background="Transparent" UseLayoutRounding="True" SizeChanged="RootGrid_SizeChanged">
    </Grid>
</Window>
